{
  "name": "@0xdoublesharp/adaptive-cache",
  "version": "0.2.0",
  "description": "Adaptive caching module for Redis with Fastify and Express integration",
  "author": "Justin Silver",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/doublesharp/adaptive-cache.git"
  },
  "bugs": {
    "url": "https://github.com/doublesharp/adaptive-cache/issues"
  },
  "homepage": "https://github.com/doublesharp/adaptive-cache#readme",
  "keywords": [
    "adaptive",
    "cache",
    "redis",
    "fastify",
    "express",
    "typescript",
    "nodejs",
    "lua",
    "compression"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "packageManager": "pnpm@10.25.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint .",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "quality": "pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build && pnpm run test:types && pnpm run test:packed",
    "bench:configs": "node --expose-gc scripts/benchmark-configs.mjs",
    "clean": "rm -rf dist coverage",
    "test:types": "tsc --ignoreConfig --noEmit --strict --target es2022 --module nodenext --moduleResolution nodenext --esModuleInterop --skipLibCheck test/types/consumer.ts",
    "bench:lru": "node --expose-gc scripts/benchmark-lru-upgrade.mjs",
    "test:packed": "node scripts/packed-package-smoke.mjs",
    "test:compat": "node scripts/packed-package-smoke.mjs all"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "ioredis": "^6.0.0"
  },
  "devDependencies": {
    "@0xdoublesharp/lru-cache-clustered": "2.1.2",
    "@eslint/js": "^10.0.1",
    "@types/debug": "^4.1.13",
    "@types/express": "^5.0.6",
    "@types/node": "^26.6.4",
    "@types/supertest": "^7.2.1",
    "@typescript-eslint/eslint-plugin": "^8.71.1",
    "@typescript-eslint/parser": "^8.71.1",
    "@vitest/coverage-v8": "^5.0.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "express": "^5.2.1",
    "fastify": "^5.12.5",
    "lru-cache": "^11.5.3",
    "prettier": "^3.9.9",
    "supertest": "^7.3.1",
    "testcontainers": "^12.2.0",
    "tsup": "^8.5.1",
    "typescript": "^6.0.3",
    "vitest": "^5.0.3"
  },
  "peerDependencies": {
    "@0xdoublesharp/lru-cache-clustered": "^2.1.2",
    "express": "^4.18.2 || ^5.0.0",
    "fastify": "^4.0.0 || ^5.0.0",
    "lru-cache": "^11.0.0"
  },
  "peerDependenciesMeta": {
    "@0xdoublesharp/lru-cache-clustered": {
      "optional": true
    },
    "express": {
      "optional": true
    },
    "fastify": {
      "optional": true
    },
    "lru-cache": {
      "optional": true
    }
  }
}
