{
  "name": "@0xdoublesharp/adaptive-cache",
  "version": "0.0.3",
  "description": "Adaptive caching module for Redis with Fastify and Express integration",
  "keywords": [
    "adaptive",
    "cache",
    "redis",
    "fastify",
    "express",
    "typescript",
    "nodejs",
    "lua",
    "compression"
  ],
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.mjs",
      "require": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "clean": "rm -rf dist coverage"
  },
  "dependencies": {
    "debug": "^4.4.3",
    "ioredis": "^5.8.2"
  },
  "devDependencies": {
    "@types/debug": "^4.1.12",
    "@types/express": "^5.0.5",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "@vitest/coverage-v8": "^4.0.13",
    "c8": "^10.1.3",
    "express": "^5.1.0",
    "fastify": "^5.6.2",
    "fastify-plugin": "^5.1.0",
    "prettier": "^3.6.2",
    "supertest": "^7.1.4",
    "testcontainers": "^11.8.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vitest": "^4.0.13"
  },
  "peerDependencies": {
    "express": "^4.18.2",
    "fastify": "^4.0.0 || ^5.0.0"
  }
}
